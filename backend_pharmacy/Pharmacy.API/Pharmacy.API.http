@host = https://localhost:5160

### Register a customer
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Customer",
  "email": "customer@test.com",
  "password": "Test@1234",
  "role": "Customer"
}

### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "customer@test.com",
  "password": "Test@1234"
}