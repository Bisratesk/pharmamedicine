@host = http://localhost:5160
# Swagger UI: http://localhost:5160/swagger (or https://localhost:7205/swagger)
@pharmacyId = 1

# Paste each token ONCE: send the matching LOGIN request, copy the long "token"
# text from the response (no quotes), paste it after the = sign.
@customerToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..BqgyQ0VlDwVZn9CnHTblqr8AnS5XlrtwftkehqSv_B4
@ownerToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..hE5OswXqYy0Q5WwUzY2Qd03AzFeBaM5PHWWS0Fdy45o
@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..eK4v9X8r53bvJi-70f-7_QoGdDMVndoffPfGC9-7j9o

# After adding stock, paste the returned "id" here:
@paracetamolId = 
@amoxId = 

### 0. SETUP

### Register a customer (201, or 409 if it exists)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Customer",
  "email": "customer@test.com",
  "password": "Test@1234",
  "role": "Customer"
}

### Register an owner (201, or 409 if it exists)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Owner",
  "email": "owner@test.com",
  "password": "Test@1234",
  "role": "PharmacyOwner"
}

### LOGIN customer: copy token into @customerToken
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "customer@test.com",
  "password": "Test@1234"
}

### LOGIN owner: copy token into @ownerToken
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@test.com",
  "password": "Test@1234"
}

### LOGIN admin: copy token into @adminToken
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@pharmacy.com",
  "password": "Admin@12345"
}

### 1. PHARMACIES (owner)

### Register a pharmacy (201, then 409 if repeated)
POST {{host}}/api/pharmacies
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "name": "Mad Med",
  "address": "Bole",
  "phone": "0912345678",
  "licenseNumber": "LIC-2345",
  "latitude": 9.03,
  "longitude": 38.74,
  "openingTime": "08:00",
  "closingTime": "22:00"
}

### Get my pharmacy (200)
GET {{host}}/api/pharmacies/mine
Authorization: Bearer {{ownerToken}}

### Customer registers a pharmacy (403)
POST {{host}}/api/pharmacies
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "name": "Not Allowed",
  "address": "Bole",
  "phone": "0912345678",
  "licenseNumber": "LIC-9999",
  "latitude": 9.03,
  "longitude": 38.74,
  "openingTime": "08:00",
  "closingTime": "22:00"
}

#################################################
### 2. PHARMACIES (admin)
#################################################

### A1. List all (200)
GET {{host}}/api/pharmacies
Authorization: Bearer {{adminToken}}

### A2. Only pending (200)
GET {{host}}/api/pharmacies?status=Pending
Authorization: Bearer {{adminToken}}

### A3. Search (200)
GET {{host}}/api/pharmacies?search=mad
Authorization: Bearer {{adminToken}}

### A4. Approve (200)
PUT {{host}}/api/pharmacies/{{pharmacyId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "Approved"
}

### A5. Pending again (200, empty after A4)
GET {{host}}/api/pharmacies?status=Pending
Authorization: Bearer {{adminToken}}

### A6. Owner tries the admin list (403)
GET {{host}}/api/pharmacies
Authorization: Bearer {{ownerToken}}

### A7. Invalid status (400)
PUT {{host}}/api/pharmacies/{{pharmacyId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "Banana"
}

### 3. STOCK (send A4 first so the pharmacy is Approved)

### S1. Owner adds Paracetamol (201). Paste the "id" into @paracetamolId
POST {{host}}/api/pharmacies/{{pharmacyId}}/stock
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "medicineName": "Paracetamol 500mg",
  "price": 45.50,
  "quantity": 60
}

### S2. Owner lists stock (200)
GET {{host}}/api/pharmacies/{{pharmacyId}}/stock
Authorization: Bearer {{ownerToken}}

### S3. Owner edits Paracetamol (200)
PUT {{host}}/api/stock/{{paracetamolId}}
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "medicineName": "Paracetamol 500mg",
  "price": 42.00,
  "quantity": 55
}

### S4. Admin sees all stock (200)
GET {{host}}/api/stock
Authorization: Bearer {{adminToken}}

### S5. Customer adds stock (403)
POST {{host}}/api/pharmacies/{{pharmacyId}}/stock
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
  "medicineName": "Nope",
  "price": 10,
  "quantity": 1
}

### S6. Price 0 (400)
POST {{host}}/api/pharmacies/{{pharmacyId}}/stock
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "medicineName": "Bad Price",
  "price": 0,
  "quantity": 1
}

#################################################
### 4. SEARCH (customer; needs S1 done)
#################################################

### Q1. Basic (200)
GET {{host}}/api/search?medicine=para
Authorization: Bearer {{customerToken}}

### Q2. With location (200, distanceKm about 3)
GET {{host}}/api/search?medicine=para&lat=9.05&lng=38.76
Authorization: Bearer {{customerToken}}

### Q3. Within 1 km (200, empty)
GET {{host}}/api/search?medicine=para&lat=9.05&lng=38.76&maxKm=1
Authorization: Bearer {{customerToken}}

### Q4. Within 10 km, nearest first (200)
GET {{host}}/api/search?medicine=para&lat=9.05&lng=38.76&maxKm=10&sort=nearest
Authorization: Bearer {{customerToken}}

### Q5. Max price 10 (200, empty)
GET {{host}}/api/search?medicine=para&maxPrice=10
Authorization: Bearer {{customerToken}}

### Q6. No medicine (400)
GET {{host}}/api/search?medicine=
Authorization: Bearer {{customerToken}}

### Q7. Nearest without location (400)
GET {{host}}/api/search?medicine=para&sort=nearest
Authorization: Bearer {{customerToken}}

### Q8. Owner searches (403)
GET {{host}}/api/search?medicine=para
Authorization: Bearer {{ownerToken}}

### Q9. No token (401)
GET {{host}}/api/search?medicine=para

#################################################
### 5. ACTIVITY LOG
#################################################

### L1. Admin reads the log (200)
GET {{host}}/api/activity
Authorization: Bearer {{adminToken}}

### L2. Owner reads the log (403)
GET {{host}}/api/activity
Authorization: Bearer {{ownerToken}}

### L3. No token (401)
GET {{host}}/api/activity

### L4. take=0 (400)
GET {{host}}/api/activity?take=0
Authorization: Bearer {{adminToken}}

### T1. Owner adds Amoxicillin (201). Paste the "id" into @amoxId
POST {{host}}/api/pharmacies/{{pharmacyId}}/stock
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "medicineName": "Amoxicillin 500mg",
  "price": 130.00,
  "quantity": 25
}

### T2. Read the log: newest line should be "... added Amoxicillin ..."
GET {{host}}/api/activity
Authorization: Bearer {{adminToken}}

### T3. Admin edits Amoxicillin (200). Log: "Admin updated ..."
PUT {{host}}/api/stock/{{amoxId}}
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "medicineName": "Amoxicillin 500mg",
  "price": 125.00,
  "quantity": 20
}

### T4. Admin sets status (200). Log: "... was Approved"
PUT {{host}}/api/pharmacies/{{pharmacyId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "status": "Approved"
}

### T5. Entries after id 2 (200)
GET {{host}}/api/activity?afterId=2
Authorization: Bearer {{adminToken}}

### T6. Duplicate add (409) and NO new log line
POST {{host}}/api/pharmacies/{{pharmacyId}}/stock
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "medicineName": "Amoxicillin 500mg",
  "price": 130.00,
  "quantity": 25
}

### T7. Owner deletes Amoxicillin (204). Log: "... removed Amoxicillin ..."
DELETE {{host}}/api/stock/{{amoxId}}
Authorization: Bearer {{ownerToken}}

### 6. CLEANUP (send last)

### Owner deletes Paracetamol (204)
DELETE {{host}}/api/stock/{{paracetamolId}}
Authorization: Bearer {{ownerToken}}