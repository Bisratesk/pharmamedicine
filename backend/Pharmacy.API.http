@host = http://localhost:5160

### Register a customer
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Customer",
  "email": "customer@test.com",
  "password": "Test@1234",
  "role": "Customer"
}

### Login as customer
# @name customerLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "fullName": "Test Owner",
  "email": "owner@test.com",
  "password": "Test@1234",
  "role": "PharmacyOwner"
}
### Register an owner
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Owner",
  "email": "owner@test.com",
  "password": "Test@1234",
  "role": "PharmacyOwner"
}

### Login as owner
# @name ownerLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@test.com",
  "password": "Test@1234"
}

### Register a pharmacy (owner)
POST {{host}}/api/pharmacies
Content-Type: application/json
Authorization: Bearer {{ownerLogin.response.body.$.token}}

{
  "name": "Mad Med",
  "address": "Bole",
  "phone": "0912345678",
  "licenseNumber": "LIC-2345",
  "latitude": 9.03,
  "longitude": 38.74,
  "openingTime": "08:00",
  "closingTime": "22:00"
}

### Get my pharmacy (owner)
GET {{host}}/api/pharmacies/mine
Authorization: Bearer {{ownerLogin.response.body.$.token}}

### Customer tries to register a pharmacy (should be 403)
POST {{host}}/api/pharmacies
Content-Type: application/json
Authorization: Bearer {{customerLogin.response.body.$.token}}

{
  "name": "Not Allowed",
  "address": "Bole",
  "phone": "0912345678",
  "licenseNumber": "LIC-9999",
  "latitude": 9.03,
  "longitude": 38.74,
  "openingTime": "08:00",
  "closingTime": "22:00"
}
### A1. Login as admin
# @name adminLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@pharmacy.com",
  "password": "Admin@12345"
}

### A2. Admin: list all pharmacies
GET {{host}}/api/pharmacies
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7OtjtS9ifv--X5fGI6Z2QhQfun9foBzAgnm4znLG-v4

### A3. Admin: only pending
GET {{host}}/api/pharmacies?status=Pending
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7OtjtS9ifv--X5fGI6Z2QhQfun9foBzAgnm4znLG-v4

### A4. Admin: search
GET {{host}}/api/pharmacies?search=mad
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7OtjtS9ifv--X5fGI6Z2QhQfun9foBzAgnm4znLG-v4       

### A5. Admin: approve pharmacy 1
PUT {{host}}/api/pharmacies/1/status
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..7OtjtS9ifv--X5fGI6Z2QhQfun9foBzAgnm4znLG-v4

{
  "status": "Approved"
}

### A6. Admin: pending again (should now be empty)
GET {{host}}/api/pharmacies?status=Pending
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9

### A7. Owner tries the admin list (should be 403)
GET {{host}}/api/pharmacies
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9